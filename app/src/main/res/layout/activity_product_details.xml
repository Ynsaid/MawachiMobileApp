<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_white"
    tools:context=".ProductDetailsActivity">
    <ImageView
        android:id="@+id/productImage"
        android:layout_width="match_parent"
        android:layout_height="355dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        android:src="@drawable/sheep_img"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
    />
    <TextView
        android:id="@+id/about_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="حول"
        android:fontFamily="@font/changa_bold"
        android:textSize="28dp"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        />
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/arrow_white_icon"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/about_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/about_text"

        />
    <TextView
        android:id="@+id/productName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="كباش اولاد جلال"
        android:fontFamily="@font/changa_bold"
        android:textSize="28dp"
        android:textColor="@color/olive_green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/productImage"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/locationCntr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/productName">
        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:id="@+id/location_cntr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/white"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/locationIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/location_icon"
                android:layout_gravity="center"
                />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/locationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="واد سوف"
            android:fontFamily="@font/changa_semibold"
            android:textSize="16dp"
            android:textColor="@color/grey"
            app:layout_constraintTop_toTopOf="@id/location_cntr"
            app:layout_constraintBottom_toBottomOf="@id/location_cntr"
            app:layout_constraintEnd_toStartOf="@id/location_cntr"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="16dp"
            />
        <!-- the first row -->
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weightCntr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/locationCntr"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/productName">
        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:id="@+id/weightBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/white"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/weightIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/weight_icon"
                android:layout_gravity="center"
                />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/weightText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="57 كغ"
            android:fontFamily="@font/changa_semibold"
            android:textSize="16dp"
            android:textColor="@color/grey"
            app:layout_constraintTop_toTopOf="@id/weightBg"
            app:layout_constraintBottom_toBottomOf="@id/weightBg"
            app:layout_constraintEnd_toStartOf="@id/weightBg"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="16dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ageCntr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/weightCntr"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/productName">
        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:id="@+id/ageBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/white"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/ageIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/age_icon"
                android:layout_gravity="center"
                />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/ageText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="عام واحد"
            android:fontFamily="@font/changa_semibold"
            android:textSize="16dp"
            android:textColor="@color/grey"
            app:layout_constraintTop_toTopOf="@id/ageBg"
            app:layout_constraintBottom_toBottomOf="@id/ageBg"
            app:layout_constraintEnd_toStartOf="@id/ageBg"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="16dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/amountCntr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/locationCntr">
        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:id="@+id/amountBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/white"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/amountIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/amount_icon"
                android:layout_gravity="center"
                />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/amountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="44 رأس"
            android:fontFamily="@font/changa_semibold"
            android:textSize="16dp"
            android:textColor="@color/grey"
            app:layout_constraintTop_toTopOf="@id/amountBg"
            app:layout_constraintBottom_toBottomOf="@id/amountBg"
            app:layout_constraintEnd_toStartOf="@id/amountBg"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="16dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nbrofbuyersCntr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@id/amountCntr"
        app:layout_constraintTop_toBottomOf="@id/locationCntr">
        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:id="@+id/nbrofbuyersBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/white"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/nbrofbuyersIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/person_icon"
                android:layout_gravity="center"
                />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/nbrofbuyersText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="22 مشتري"
            android:fontFamily="@font/changa_semibold"
            android:textSize="16dp"
            android:textColor="@color/grey"
            app:layout_constraintTop_toTopOf="@id/nbrofbuyersBg"
            app:layout_constraintBottom_toBottomOf="@id/nbrofbuyersBg"
            app:layout_constraintEnd_toStartOf="@id/nbrofbuyersBg"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="16dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/descriptionTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/description"
        app:layout_constraintTop_toBottomOf="@id/amountCntr"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/changa_medium"
        android:textSize="20sp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/changa_regular"
        android:textSize="14sp"
        android:text="تجربى وصف كباش سلالة ولاد جلال حيث تعتبر افضل سلالة في الجزائر"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/descriptionTxt"
        android:textColor="@color/grey" />

    <TextView
        android:id="@+id/amount_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/amount"
        android:textColor="@color/black"
        android:fontFamily="@font/changa_medium"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/description"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/amountBtnCntr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/amount_txt"
        app:layout_constraintBottom_toBottomOf="@id/amount_txt"

        android:layout_marginStart="16dp">

        <!-- Minus Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/minusButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/white"
            android:background="@drawable/bg_rounded_button"
            android:text="−"
            android:layout_margin="4dp"
            android:textColor="@color/grey"
            android:textSize="18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Quantity Text -->
        <TextView
            android:id="@+id/quantityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/changa_bold"
            app:layout_constraintStart_toEndOf="@id/minusButton"
            app:layout_constraintTop_toTopOf="@id/minusButton"
            app:layout_constraintEnd_toStartOf="@id/plusButton"
            app:layout_constraintBottom_toBottomOf="@id/minusButton" />

        <!-- Plus Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/plusButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_rounded_button"
            android:text="+"
            android:textColor="@color/grey"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@id/minusButton"
            app:layout_constraintStart_toEndOf="@id/quantityText"
            app:layout_constraintTop_toTopOf="@id/minusButton"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addToCartBtn"
        android:layout_width="175dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/add_to_cart"
        android:fontFamily="@font/changa_bold"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/olive_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amountBtnCntr"
        app:layout_constraintBottom_toBottomOf="parent" />
    <TextView
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50000 د.ج"
        android:fontFamily="@font/changa_bold"
        android:textSize="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/addToCartBtn"
        app:layout_constraintBottom_toBottomOf="@id/addToCartBtn"
        android:layout_marginStart="16dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>